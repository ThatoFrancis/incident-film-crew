# Google AI — get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Grafana Cloud — create a service account token in Grafana (Administration > Service accounts)
GRAFANA_URL=https://yourstack.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_your_token

# Path to the Grafana MCP server binary (https://github.com/grafana/mcp-grafana/releases)
MCP_GRAFANA_CMD=C:\path\to\mcp-grafana.exe

# Demo telemetry push (Grafana Cloud portal > stack > Prometheus/Loki details;
# token: Access Policies with metrics:write + logs:write)
GC_METRICS_URL=https://prometheus-prod-XX-prod-region.grafana.net/api/v1/push/influx/write
GC_METRICS_USER=your-prometheus-instance-id
GC_LOGS_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GC_LOGS_USER=your-loki-user-id
GC_WRITE_TOKEN=glc_your_write_token

